# ── MIRRR Environment Variables ──────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# .env is listed in .gitignore — never commit real keys.

# ── Qloo taste API ─────────────────────────────────────────────────────────────
# Get your key at https://hackathon.api.qloo.com
# Without this key the app runs in demo-only mode (curated seed profiles).
QLOO_API_KEY=

# ── Narration (optional) ──────────────────────────────────────────────────
# If neither is set, narration falls back to a rich built-in template.
# Optional external narration key
OPENAI_API_KEY=

# Optional second narration key
GEMINI_API_KEY=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Requests per minute per IP (default: 30)
RATE_LIMIT_RPM=30
